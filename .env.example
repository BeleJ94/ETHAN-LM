APP_NAME="ETHAN LM"
APP_ENV=local
APP_DEBUG=true
# Sous-dossier d'accès (XAMPP : /ETHAN-LM ; vhost dédié : vide)
APP_BASE_PATH=/ETHAN-LM
APP_LOCALE=fr
APP_TIMEZONE=Africa/Lubumbashi
# Devise de base : toute valorisation (CMUP) est exprimée dans cette devise
APP_CURRENCY=USD

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ethan_lm
DB_USER=root
DB_PASS=

MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=no-reply@example.com

# Société émettrice (en-tête des PO fournisseurs et bons de livraison)
COMPANY_NAME="ETHAN"
COMPANY_ADDRESS=
COMPANY_CITY="Lubumbashi, RDC"
COMPANY_PHONE=
COMPANY_EMAIL=
COMPANY_RCCM=
COMPANY_ID_NAT=
COMPANY_NIF=

# OCR (optionnel) : chemins vers tesseract.exe et pdftoppm.exe
TESSERACT_PATH=
PDFTOPPM_PATH=
TESSERACT_LANG=fra+eng
PDFTOTEXT_PATH=
