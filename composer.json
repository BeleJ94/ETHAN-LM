{
    "name": "belej-consulting/ethan-lm",
    "description": "ETHAN LM — Logistics Management (commandes, achats, importations, stockage)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "phpmailer/phpmailer": "^6.9",
        "smalot/pdfparser": "^2.11"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": { "App\\": "app/" },
        "files": ["app/Core/helpers.php"]
    },
    "autoload-dev": {
        "psr-4": { "Tests\\": "tests/" }
    },
    "scripts": {
        "serve": "php -S localhost:8080 -t public public/index.php",
        "migrate": "php bin/migrate.php",
        "test": "phpunit"
    },
    "config": { "sort-packages": true }
}
